using BlApi;
using System;
using System.Linq;
using System.Windows.Forms;

namespace UI
{
    public partial class CustomerPage : Form
    {
        private readonly IBl bl = Factory.Get();

        public CustomerPage()
        {
            InitializeComponent();
            LoadCustomers();
        }

        private void LoadCustomers()
        {
            try
            {
                CustomerList.DataSource = bl.Customer.ReadAll();
            }
            catch { MessageBox.Show("Error loading customers"); }
        }

        private void ReadBT_Click(object sender, EventArgs e)
        {
            if (CustomerList.SelectedRows.Count > 0)
            {
                var customer = (BO.Customer)CustomerList.SelectedRows[0].DataBoundItem;
                MessageBox.Show(customer.ToString());
            }
        }

        private void ReadAllBT_Click(object sender, EventArgs e)
        {
            LoadCustomers();
        }

        private void CreateBT_Click(object sender, EventArgs e)
        {
            // Open add customer form
            MessageBox.Show("Add Customer feature not yet implemented");
        }

        private void UpdateBT_Click(object sender, EventArgs e)
        {
            if (CustomerList.SelectedRows.Count > 0)
            {
                MessageBox.Show("Update Customer feature not yet implemented");
            }
        }

        private void DeleteBT_Click(object sender, EventArgs e)
        {
            if (CustomerList.SelectedRows.Count > 0)
            {
                var customer = (BO.Customer)CustomerList.SelectedRows[0].DataBoundItem;
                bl.Customer.Delete(customer.Id);
                LoadCustomers();
            }
        }

        private void CustomerFilterBT_Click(object sender, EventArgs e)
        {
            // Filter by name in textbox
        }

        private void FilterTB_TextChanged(object sender, EventArgs e)
        {
            var filter = FilterTB.Text.ToLower();
            var all = bl.Customer.ReadAll();
            CustomerList.DataSource = all.Where(c => c.Name.ToLower().Contains(filter)).ToList();
        }
    }
}
