using BlApi;
using System;
using System.Linq;
using System.Windows.Forms;

namespace UI
{
    public partial class ProductPage : Form
    {
        private readonly IBl bl = Factory.Get();

        public ProductPage()
        {
            InitializeComponent();
            LoadProducts();
        }

        private void LoadProducts()
        {
            try
            {
                ProductList.DataSource = bl.Product.ReadAll();
            }
            catch { MessageBox.Show("Error loading products"); }
        }

        private void AddBT_Click(object sender, EventArgs e)
        {
            var addForm = new ProductEditForm(bl);
            if (addForm.ShowDialog() == DialogResult.OK)
                LoadProducts();
        }

        private void UpdateBT_Click(object sender, EventArgs e)
        {
            if (ProductList.SelectedRows.Count > 0)
            {
                var product = (BO.Product)ProductList.SelectedRows[0].DataBoundItem;
                var editForm = new ProductEditForm(bl, product);
                if (editForm.ShowDialog() == DialogResult.OK)
                    LoadProducts();
            }
        }

        private void DeleteBT_Click(object sender, EventArgs e)
        {
            if (ProductList.SelectedRows.Count > 0)
            {
                var product = (BO.Product)ProductList.SelectedRows[0].DataBoundItem;
                bl.Product.Delete(product.Id);
                LoadProducts();
            }
        }

        private void FilterTB_TextChanged(object sender, EventArgs e)
        {
            var filter = FilterTB.Text.ToLower();
            ProductList.DataSource = bl.Product.ReadAll()
                .Where(p => p.Name.ToLower().Contains(filter)).ToList();
        }
    }
}