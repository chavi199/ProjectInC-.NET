using BlApi;
using System;
using System.Linq;
using System.Windows.Forms;

namespace UI
{
    public partial class CashierOrderForm : Form
    {
        private readonly IBl bl = Factory.Get();
        private BO.Order currentOrder;

        public CashierOrderForm()
        {
            InitializeComponent();
            currentOrder = new BO.Order
            {
                Products = new System.Collections.Generic.List<BO.ProductInOrder>(),
                IsPreferredCustomer = false,
                FinalPrice = 0
            };
            LoadProducts();
            UpdateOrderSummary();
        }

        private void LoadProducts()
        {
            try
            {
                var products = bl.Product.ReadAll();
                ProductList.DataSource = products?.ToList() ?? new System.Collections.Generic.List<BO.Product>();
            }
            catch (Exception ex)
            {
                Utils.Log(ex);
                MessageBox.Show("Error loading products: " + ex.Message);
            }
        }

        private void AddProductBT_Click(object sender, EventArgs e)
        {
            try
            {
                int productId = 0;
                int quantity = 1;

                if (!string.IsNullOrWhiteSpace(ProductCodeTB.Text) && int.TryParse(ProductCodeTB.Text, out productId))
                {
                    var product = bl.Product.Read(productId);
                    if (product != null)
                    {
                        bl.Order.AddProductToOrder(currentOrder, productId, quantity);
                        ProductCodeTB.Clear();
                        UpdateOrderSummary();
                    }
                    else
                        MessageBox.Show("Product not found");
                }
                else if (ProductList.SelectedRows.Count > 0)
                {
                    var product = ProductList.SelectedRows[0].DataBoundItem as BO.Product;
                    if (product != null)
                    {
                        bl.Order.AddProductToOrder(currentOrder, product.Id, quantity);
                        UpdateOrderSummary();
                    }
                }
                else
                    MessageBox.Show("Please enter product code or select from list");
            }
            catch (Exception ex)
            {
                Utils.Log(ex);
                MessageBox.Show("Error adding product to order: " + ex.Message);
            }
        }

        private void UpdateOrderSummary()
        {
            try
            {
                OrderSummaryList.DataSource = null;
                OrderSummaryList.DataSource = currentOrder?.Products?.ToList() ?? new System.Collections.Generic.List<BO.ProductInOrder>();
                TotalLabel.Text = $"סה\"כ: {currentOrder?.FinalPrice ?? 0}";
            }
            catch (Exception ex) { Utils.Log(ex); MessageBox.Show("Error updating summary: " + ex.Message); }
        }

        private void DoOrderBT_Click(object sender, EventArgs e)
        {
            try
            {
                if (currentOrder?.Products == null || currentOrder.Products.Count == 0)
                {
                    MessageBox.Show("Order is empty");
                    return;
                }

                // guard: ensure products still exist / enough amount
                foreach (var p in currentOrder.Products)
                {
                    var prod = bl.Product.Read(p.ProductId);
                    if (prod == null) throw new Exception($"Product id {p.ProductId} not found");
                    if (prod.Amount < p.Quantity) throw new Exception($"Not enough stock for product {p.ProductId}");
                }

                bl.Order.DoOrder(currentOrder);
                MessageBox.Show("Order completed successfully!");
                currentOrder = new BO.Order
                {
                    Products = new System.Collections.Generic.List<BO.ProductInOrder>(),
                    IsPreferredCustomer = false,
                    FinalPrice = 0
                };
                UpdateOrderSummary();
            }
            catch (Exception ex)
            {
                Utils.Log(ex);
                MessageBox.Show("Error processing order: " + ex.Message);
            }
        }
    }
}