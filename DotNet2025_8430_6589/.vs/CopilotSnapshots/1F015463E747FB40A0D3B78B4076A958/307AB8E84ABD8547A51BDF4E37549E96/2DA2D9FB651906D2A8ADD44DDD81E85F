using System;
using System.Diagnostics;
using System.IO;

namespace UI
{
    internal static class Utils
    {
        private static readonly string LogPath = Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "ui-errors.log");

        public static void Log(Exception ex)
        {
            try
            {
                var line = $"{DateTime.Now:yyyy-MM-dd HH:mm:ss} | {ex.GetType().FullName} | {ex.Message}\n{ex.StackTrace}\n";
                File.AppendAllText(LogPath, line);
                Debug.WriteLine(line);
            }
            catch
            {
                // swallow - logging must not crash app
            }
        }

        public static void LogMessage(string message)
        {
            try
            {
                var line = $"{DateTime.Now:yyyy-MM-dd HH:mm:ss} | MSG | {message}\n";
                File.AppendAllText(LogPath, line);
                Debug.WriteLine(line);
            }
            catch { }
        }
    }
}